{
  "name": "@gamekit/test-utils",
  "version": "0.1.0-alpha.3",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-library-package.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/test-utils/test --passWithNoTests",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@gamekit/event-bus": "workspace:*",
    "@gamekit/platform-core": "workspace:*",
    "@gamekit/renderer-core": "workspace:*",
    "@gamekit/world": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": "^3.1.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
