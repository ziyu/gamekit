{
  "name": "@gamekit/app-host",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-library-package.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/app-host/test --passWithNoTests",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@gamekit/asset": "workspace:*",
    "@gamekit/camera-core": "workspace:*",
    "@gamekit/core": "workspace:*",
    "@gamekit/data": "workspace:*",
    "@gamekit/devtools": "workspace:*",
    "@gamekit/driver-core": "workspace:*",
    "@gamekit/gas": "workspace:*",
    "@gamekit/game-runtime": "workspace:*",
    "@gamekit/input-core": "workspace:*",
    "@gamekit/platform-core": "workspace:*",
    "@gamekit/renderer-core": "workspace:*",
    "@gamekit/save": "workspace:*",
    "@gamekit/tca": "workspace:*",
    "@gamekit/ui-core": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "gamekitBuild": {
    "bundleDts": false
  }
}
