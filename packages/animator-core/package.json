{
  "name": "@gamekit/animator-core",
  "version": "0.1.0-alpha.6",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playback": {
      "types": "./dist/playback/index.d.ts",
      "import": "./dist/playback/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-library-package.mjs",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/animator-core/test --passWithNoTests",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@gamekit/asset": "workspace:*",
    "@gamekit/core": "workspace:*",
    "@gamekit/data": "workspace:*",
    "@gamekit/event-bus": "workspace:*",
    "@gamekit/game-runtime": "workspace:*",
    "@gamekit/renderer-core": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "gamekitBuild": {
    "bundleDts": false,
    "entries": [
      "src/index.ts",
      "src/playback/index.ts",
      "src/testing/index.ts"
    ]
  }
}
