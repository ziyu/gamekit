    "@gamekit/asset": "workspace:*",
    "@gamekit/audio-core": "workspace:*",
    "@gamekit/character-controller": "workspace:*",
    "@gamekit/combat": "workspace:*",
    "@gamekit/data": "workspace:*",
    "@gamekit/driver-core": "workspace:*",
    "@gamekit/driver-three": "workspace:*",
    "@gamekit/event-bus": "workspace:*",
    "@gamekit/game-runtime": "workspace:*",
    "@gamekit/gas": "workspace:*",
    "@gamekit/multiplayer-colyseus": "workspace:*",
    "@gamekit/multiplayer-core": "workspace:*",
