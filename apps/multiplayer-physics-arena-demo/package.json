    "@types/three": "^0.184.1",
    "@gamekit/test-utils": "workspace:*",
    "@gamekit/multiplayer-memory": "workspace:*",
    "tsx": "^4.19.4",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
