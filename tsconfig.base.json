{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@gamekit/core": ["packages/core/src/index.ts"],
      "@gamekit/world": ["packages/world/src/index.ts"],
      "@gamekit/world-koota": ["packages/world-koota/src/index.ts"],
      "@gamekit/event-bus": ["packages/event-bus/src/index.ts"],
      "@gamekit/game-runtime": ["packages/game-runtime/src/index.ts"],
      "@gamekit/camera-core": ["packages/camera-core/src/index.ts"],
      "@gamekit/renderer-core": ["packages/renderer-core/src/index.ts"],
      "@gamekit/renderer-phaser": ["packages/renderer-phaser/src/index.ts"],
      "@gamekit/input-core": ["packages/input-core/src/index.ts"],
      "@gamekit/input-dom": ["packages/input-dom/src/index.ts"],
      "@gamekit/platform-core": ["packages/platform-core/src/index.ts"],
      "@gamekit/platform-web": ["packages/platform-web/src/index.ts"],
      "@gamekit/platform-tauri": ["packages/platform-tauri/src/index.ts"],
      "@gamekit/data": ["packages/data/src/index.ts"],
      "@gamekit/driver-core": ["packages/driver-core/src/index.ts"],
      "@gamekit/driver-phaser": ["packages/driver-phaser/src/index.ts"],
      "@gamekit/driver-three": ["packages/driver-three/src/index.ts"],
      "@gamekit/asset": ["packages/asset/src/index.ts"],
      "@gamekit/app-host": ["packages/app-host/src/index.ts"],
      "@gamekit/tca": ["packages/tca/src/index.ts"],
      "@gamekit/gas": ["packages/gas/src/index.ts"],
      "@gamekit/ui-core": ["packages/ui-core/src/index.ts"],
      "@gamekit/react-ui": ["packages/react-ui/src/index.ts"],
      "@gamekit/save": ["packages/save/src/index.ts"],
      "@gamekit/devtools": ["packages/devtools/src/index.ts"],
      "@gamekit/devtools-ui": ["packages/devtools-ui/src/index.ts"],
      "@gamekit/test-utils": ["packages/test-utils/src/index.ts"]
    }
  }
}
